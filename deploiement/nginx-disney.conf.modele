# MODÈLE — le sous-domaine n'est PAS choisi.
# Lancer d'abord ./inspecter-serveur.sh sur mon-serveur, valider le nom
# avec le parent, puis remplacer SOUS_DOMAINE.DOMAINE partout ci-dessous.
#
# Ensuite seulement :
#   sudo certbot --nginx -d SOUS_DOMAINE.DOMAINE
# (certbot avec l'authenticator nginx, comme le reste du serveur)

server {
    listen 80;
    listen [::]:80;
    server_name SOUS_DOMAINE.DOMAINE;
    # certbot réécrit ce bloc en redirection 443 après l'émission du certificat.
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name SOUS_DOMAINE.DOMAINE;

    # ssl_certificate / ssl_certificate_key : ajoutés par certbot.

    access_log /var/log/nginx/disney-access.log;
    error_log  /var/log/nginx/disney-error.log;

    location / {
        proxy_pass http://127.0.0.1:3021;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Le flux SSE porte le rechargement à chaud du plan (§7.2) et l'état partagé
    # entre les téléphones. Sans ces trois lignes, nginx bufferise et la page
    # ne bouge plus tant que le parent ne rafraîchit pas — exactement ce qu'on veut éviter.
    location /api/stream {
        proxy_pass http://127.0.0.1:3021;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 24h;
        chunked_transfer_encoding off;
    }
}
